{
  "name": "github-firehose",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /pulls (and any other path) serves the page; the page picks the feed from its path.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/latest"]
  },
  "routes": [{ "pattern": "firehose.ingo.au", "custom_domain": true }]
}
